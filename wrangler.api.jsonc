{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "turnocerto-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "production",
    "WEB_ORIGIN": "https://turnocerto.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "turnocerto-production",
      "database_id": "719e8c0b-a2e4-429a-b863-9830f5203eff",
      "migrations_dir": "db/migrations"
    }
  ],
  "env": {
    "production": {
      "name": "turnocerto-api-production",
      "vars": {
        "APP_ENV": "production",
        "WEB_ORIGIN": "https://turnocerto.pages.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "turnocerto-production",
          "database_id": "719e8c0b-a2e4-429a-b863-9830f5203eff",
          "migrations_dir": "db/migrations"
        }
      ]
    },
    "preview": {
      "name": "turnocerto-api-preview",
      "vars": {
        "APP_ENV": "preview",
        "WEB_ORIGIN": "https://preview.turnocerto.pages.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "turnocerto-preview",
          "database_id": "3527c507-1a42-4ad3-bce1-6cf26ad0342e",
          "migrations_dir": "db/migrations"
        }
      ]
    }
  }
}
